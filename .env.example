# ===== 部署环境变量示例 =====
# 复制此文件为 .env 并填写真实值（本地开发用）
# Render 部署时在 Dashboard > Environment 中添加这些变量

# AI 内容审核配置（OpenAI 兼容格式，可自选服务商）
AI_MOD_URL=你的AI审核API地址
AI_MOD_KEY=你的API密钥
AI_MOD_MODEL=你的模型名

# PostgreSQL 数据库连接（Render 会自动注入，本地开发时手动填）
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# 服务端口（Render 自动注入 PORT，本地默认 8787）
# PORT=8787
